# --- Chain connection ---
# One or more BSC RPC endpoints, comma-separated. Reads automatically fail
# over across the whole list on a rate-limit/credit/timeout style error -
# useful if you're combining free-tier accounts from multiple providers.
# Writes (bets, claims) never auto-retry across endpoints (see rpcPool.js for
# why), but do rotate the pointer for the next attempt on failure.
# A single URL works exactly as before - RPC_URLS is optional.
RPC_URL=https://proud-lingering-meme.bsc.quiknode.pro/2d711d6968ddd1d6c7b517dcafa888b257ce3f2b/

# RPC_URLS=https://bsc-dataseed.binance.org/,https://your-account-1.example/rpc,https://your-account-2.example/rpc

# Wallet that signs and pays for bets. NEVER commit a real key to git.
# Use a wallet funded only with what you are fully willing to lose.
PRIVATE_KEY=532f91afb58b95ade734120732529c96fbbb0d0e581cf4e44a75017b62106e34

# PancakeSwap Prediction V2 contract (BNB/USDT market, BNB Chain mainnet).
# VERIFY this yourself against the verified source on BscScan before trusting
# it with real funds: https://bscscan.com/address/0x18b2a687610328590bc8f2e5fedde3b582a49cda#code
CONTRACT_ADDRESS=0x18b2a687610328590bc8f2e5fedde3b582a49cda

# The bot verifies your RPC is actually connected to this chain ID at
# startup, BEFORE making any contract calls - a wrong-network RPC (e.g. a
# testnet endpoint, or a different chain's endpoint) makes CONTRACT_ADDRESS
# not exist there, which otherwise shows up as a cryptic "missing revert
# data" error on every single call instead of one clear message. Only
# change this if you're deliberately targeting a different network.
EXPECTED_CHAIN_ID=56

# --- Safety switch ---
# true = simulate every decision and log the would-be result. No transactions
# are sent and no funds are at risk. Leave this on until you've backtested
# and watched enough live rounds to trust the win rate.
DRY_RUN=true

# --- Bet sizing / timing ---
# BET_AMOUNT_BNB is used when ENABLE_POOL_SIZING=false (flat stake per bet).
BET_AMOUNT_BNB=0.01
SNIPE_WINDOW_SECONDS=10
POLL_INTERVAL_MS=2000

# --- Signal tuning (shared by bot.js, backtest.js, sweep.js - keep in sync) ---
# Multi-timeframe confirmation: a bet only happens when both windows agree.
SHORT_LOOKBACK_SECONDS=10
LONG_LOOKBACK_SECONDS=45
# Volatility-adjusted threshold: momentum is judged in standard deviations of
# recent volatility rather than a fixed % cutoff.
# NOTE: Z_SCORE_THRESHOLD=1.0 statistically lets ~30% of pure noise through
# as a "signal" - expected for a 1-sigma bar, not a bug. Run sweep.js to see
# the win-rate / bet-frequency trade-off across thresholds automatically.
VOLATILITY_WINDOW_SECONDS=300
VOLATILITY_BUCKET_SECONDS=5
Z_SCORE_THRESHOLD=1.0

# --- Cross-asset confirmation ---
# When enabled, a second asset's recent momentum must also agree in direction
# before betting - one more independent vote, on top of the short/long
# agreement above. Backtested and swept the same as everything else when on.
ENABLE_CROSS_ASSET=false
CROSS_ASSET_SYMBOL=btcusdt

# --- Pool-imbalance bet sizing ---
# When enabled, bet size scales with how lopsided the round's BULL/BEAR pool
# already is: a bigger implied payout (betting the less-crowded side) sizes
# up toward BET_AMOUNT_MAX_BNB; a poor payout (crowded side) sizes down or
# skips entirely below MIN_PAYOUT_MULTIPLIER. TREASURY_FEE_PCT is only a
# FALLBACK - bot.js reads the live treasuryFee() from the contract at
# startup and uses that instead whenever the read succeeds (confirmed
# against the actual verified contract source: it's a real, admin-adjustable
# value, not a fixed constant). This value is only used if that live read
# fails for some reason.
# CAVEAT: this can't be backtested (no historical pool-split data available)
# - evaluate it in DRY_RUN, where simulated PnL still uses the real pool's
# reward ratio even though no real bet is placed.
ENABLE_POOL_SIZING=false
TREASURY_FEE_PCT=3
MIN_PAYOUT_MULTIPLIER=1.05
MAX_PAYOUT_MULTIPLIER_FOR_SIZING=3.0
BET_AMOUNT_MIN_BNB=0.005
BET_AMOUNT_MAX_BNB=0.02

# --- Loss limits (only enforced once DRY_RUN=false) ---
MAX_CONSECUTIVE_LOSSES=5
MAX_DAILY_LOSS_BNB=0.2

# --- Auto-claim ---
# Batches claim() across won-but-unclaimed epochs, only sending the
# transaction once the combined reward clears CLAIM_GAS_BUFFER_MULTIPLIER
# times the estimated gas cost (so a tiny win doesn't cost more in gas than
# it's worth). MAX_QUEUED_CLAIMS forces a claim once that many epochs are
# queued, regardless of the ratio, so rewards don't pile up indefinitely.
ENABLE_AUTO_CLAIM=true
CLAIM_GAS_BUFFER_MULTIPLIER=1.5
MAX_QUEUED_CLAIMS=10
CLAIM_CHECK_INTERVAL_MS=30000

# --- Backtester / sweep / walk-forward / calibration (not read by bot.js) ---
BACKTEST_HOURS=24
BACKTEST_SYMBOL=BNBUSDT
# walkforward.js: how many sequential chunks to split BACKTEST_HOURS into.
# Each fold trains a config via the same grid sweep.js uses, then tests it
# untouched on the NEXT fold - the real check for whether a config's edge
# survives out-of-sample. Needs at least 2; more folds = smaller, noisier
# chunks, so scale BACKTEST_HOURS up if you raise this.
WALKFORWARD_FOLDS=4
WALKFORWARD_MIN_SAMPLE=15

# --- Wallet-copy (alternative to everything above - highest priority) ---
# When enabled, this REPLACES every other signal: momentum, cross-asset,
# oracle-divergence, crowd-following, pool-sizing are all bypassed. Watches
# COPY_WALLET_ADDRESS's own bet on the current round (checked every tick,
# not just near lock, since they could bet any time during the round) and
# copies their exact direction and amount once they place it, up to
# COPY_WALLET_MAX_BET_BNB (a safety ceiling - if they bet more than this,
# the copy is capped at this amount instead of matching exactly).
# TIMING RISK: if they bet late in the round (e.g. their own sniping
# strategy), there may not be time left to detect it and get our own
# transaction confirmed before lock.
# Cannot be backtested - historical per-wallet bet data isn't in Binance's
# price data; evaluate in dry run (which watches the real wallet for free,
# no funds at risk).
ENABLE_WALLET_COPY=false
COPY_WALLET_ADDRESS=0xc2fa81eDF00A72dC05AE97Ab1c381856b12e0491
COPY_WALLET_MAX_BET_BNB=0.1
# Shared by the live bot's dashboard AND `npm run wallet-history` below - when
# ENABLE_WALLET_COPY is on, the dashboard shows this wallet's last 10 bets
# using the exact same scan settings. Scans backward epoch-by-epoch (not via
# eth_getLogs, which had wildly inconsistent block-range limits across RPC
# providers - one free tier caps it at just 5 blocks). WALLET_HISTORY_MAX_EPOCHS
# bounds how far back it'll look before giving up (8640 epochs =~ 30 days).
# WALLET_HISTORY_CHUNK_SIZE only groups epochs for progress reporting - it
# does NOT set how many requests fire at once. The actual request rate is
# controlled entirely by WALLET_HISTORY_REQUEST_INTERVAL_MS: every individual
# request gets its own evenly-spaced time slot (e.g. 100ms apart =~ 10/sec),
# rather than firing a burst of concurrent requests and pausing - a burst is
# what actually trips most rate limiters, even with a pause between bursts.
# Since every provider's actual limit is unknown in advance (confirmed
# inconsistent even on one provider - eth_getLogs capped at 5 blocks, plain
# requests capped at 15/second), any rate-limit-shaped error still retries
# automatically with exponential backoff (WALLET_HISTORY_MAX_RETRIES attempts,
# starting at WALLET_HISTORY_RETRY_BASE_MS) as a second line of defense.
WALLET_HISTORY_MAX_EPOCHS=8640
WALLET_HISTORY_CHUNK_SIZE=20
WALLET_HISTORY_REQUEST_INTERVAL_MS=150
WALLET_HISTORY_MAX_RETRIES=5
WALLET_HISTORY_RETRY_BASE_MS=1000

# --- Ensemble voting (alternative to everything above - highest priority) ---
# When enabled, this REPLACES the exclusive priority (wallet-copy > crowd-
# following > momentum) with a vote: momentum ALWAYS participates, and
# crowd-following/wallet-copy participate too if their own ENABLE_ flags are
# ALSO true. Each votes independently (BULL/BEAR/no-opinion, using its own
# existing thresholds unchanged - e.g. crowd-following still requires
# CROWD_MIN_MARGIN_PCT to vote at all). If at least ENSEMBLE_MIN_AGREEMENT
# of them agree on the same direction, that's the bet; otherwise the round
# is skipped. Example: with wallet-copy + momentum both enabled and
# ENSEMBLE_MIN_AGREEMENT=2, a bet only happens when they agree.
# Uses BET_AMOUNT_BNB (or pool-sizing, if enabled - pool-sizing does NOT
# apply here, for simplicity) rather than wallet-copy's exact amount, even
# when wallet-copy's vote is part of the winning majority.
# TIMING NOTE: wallet-copy's vote here only counts if the target has already
# bet by the time the snipe window arrives (unlike its standalone mode,
# which watches the whole round) - late bettors may often show as "no vote".
# Startup will refuse to run if ENSEMBLE_MIN_AGREEMENT exceeds the number of
# voters that could ever participate (e.g. requiring 2 with only momentum
# enabled), since that would skip every round forever.
# Cannot be backtested whenever crowd-following or wallet-copy participate,
# for the same reasons those modes individually can't be. Evaluate in dry run.
ENABLE_ENSEMBLE_VOTING=false
ENSEMBLE_MIN_AGREEMENT=2

# --- Crowd-following (alternative to the momentum signal) ---
# When enabled, this REPLACES the momentum/cross-asset/oracle-divergence
# signal entirely: at snipe time, bets whichever side (BULL/BEAR) currently
# has more money in the pool, provided the margin between them clears
# CROWD_MIN_MARGIN_PCT (percentage points - e.g. a 55/45 split is a 10pp
# margin). Below that margin, or with no bets yet in the pool, it skips.
# CONTRADICTS ENABLE_POOL_SIZING - that feature favors betting AGAINST the
# majority for a better payout, so it's ignored (with a startup warning) if
# both are on. Cannot be backtested (same reason as pool sizing/oracle
# divergence - no historical pool-split data from Binance); evaluate in
# dry run.
ENABLE_CROWD_FOLLOWING=false
CROWD_MIN_MARGIN_PCT=10

# --- Dashboard ---
# A local web UI at http://localhost:DASHBOARD_PORT showing live stats, PnL,
# and recent activity, instead of only console logs. Polls the running bot
# process every 2s - no data leaves your machine unless you deploy this
# somewhere with a public URL yourself.
# If a platform-assigned PORT env var is present (Railway and similar
# platforms set this automatically), it's used instead of DASHBOARD_PORT -
# no change needed to deploy there.
ENABLE_DASHBOARD=true
DASHBOARD_PORT=3000

# Where bot-state.json (stats/PnL/pending-bet recovery) is written. Only
# needs changing if you're deploying somewhere with an ephemeral default
# filesystem (e.g. Railway) - point this at a mounted persistent volume's
# path there, or this file (and the recovery it provides) gets silently
# wiped on every redeploy/restart.
STATE_FILE_PATH=bot-state.json

# --- Oracle divergence ---
# PancakeSwap's contract settles rounds using a Chainlink oracle, NOT
# Binance - and Chainlink updates only on a deviation-threshold/heartbeat
# basis (this feed updates on a 0.1% move, and can take up to ~20s), so it's
# far too sparse to compute momentum from directly. What it IS good for:
# the oracle lags Binance, so when live Binance price has drifted meaningfully
# from the oracle's last posted value, the oracle tends to catch up toward
# it. When enabled, this is used as a further required confirmation on top
# of the momentum signal - not a replacement for it.
# ORACLE_AGGREGATOR_ADDRESS is the Chainlink BNB/USD feed on BSC mainnet,
# cross-checked against BscScan, Chainlink's own feed directory, and BNB
# Chain's official docs - verify it yourself too before trusting it.
# CAVEAT: like pool sizing, this can't be backtested - reconstructing
# historical Chainlink rounds needs on-chain data Binance doesn't have, and
# would mean thousands of extra RPC calls per backtest. Evaluate it in dry
# run, where the confirm/reject decision is logged the same as if live.
ENABLE_ORACLE_DIVERGENCE=false
ORACLE_AGGREGATOR_ADDRESS=0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE
ORACLE_DIVERGENCE_THRESHOLD_PCT=0.05
ORACLE_POLL_INTERVAL_MS=3000

# --- Notifications (Discord/Telegram) ---
# Sends an alert when the bot halts (consecutive losses or daily loss cap),
# when it starts up successfully (confirms a redeploy/restart came back up,
# and states its mode + dry-run status), and if it ever crashes fatally -
# the exact things you'd otherwise only find out by checking the dashboard
# or logs yourself. Particularly worth setting up if this runs somewhere
# unattended (e.g. deployed on Railway) rather than in a terminal you're
# watching. Both channels are optional and independent - set up one, both,
# or neither. Nothing is sent unless ENABLE_NOTIFICATIONS=true AND at least
# one channel below is configured.
#
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook, copy
# its URL.
# Telegram: message @BotFather -> /newbot to get a bot token. Then message
# your new bot once (anything), then visit
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates in a browser to find
# your chat_id in the response.
ENABLE_NOTIFICATIONS=false
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Off by default - a bet resolves roughly every 5 minutes, so this can mean
# hundreds of notifications a day. Each is tagged [DRY RUN] or [LIVE], so
# it's safe to turn on during dry-run testing just to confirm your
# notification setup actually works before relying on it once live.
NOTIFY_ON_BET_RESULT=false
